# Database
# DATABASE_URL=mysql+pymysql://kdlit:password@localhost:3306/version_control_db
# MSSQL_URL=mssql+pymssql://mssql_user:mssql_password@mssql_host:1433/mssql_db_name

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=version_control_db

MSSQL_HOST=
MSSQL_PORT=
MSSQL_USER=FleetGPS
MSSQL_PASSWORD=
MSSQL_NAME=ADDON

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# Screen Control Settings
SCREEN_FRAME_TTL=5              # 畫面快取時間（秒）
SCREEN_MAX_FPS=15               # 最大幀率
SCREEN_QUALITY=60               # JPEG 壓縮品質 (1-100)
SCREEN_SCALE=2                  # 縮放倍數 (2=50%)

# Security
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# Server
HOST=0.0.0.0
PORT=5072

# File Storage
APK_STORAGE_PATH=./app/static/apks/
MAX_FILE_SIZE=500000000  # 500MB

# Nominatim reverse geocoding server (查中文地址用)
# 留空 = 停用反查，改用裝置回報的 address
NOMINATIM_BASE_URL=http://10.10.205.211:9090
# 地址回填背景任務：間隔秒數 / 每輪筆數
GEOCODE_BACKFILL_INTERVAL=300
GEOCODE_BACKFILL_BATCH=100

# CORS
CORS_ORIGINS=["", "", ""]
ALLOW_ORIGINS=*